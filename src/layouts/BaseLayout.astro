---
// src/layouts/BaseLayout.astro
const { title, className = "bg-[#121214] text-[#e1e1e6]" } = Astro.props
---
<html lang="zh-TW">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <style is:global>
      body { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; }
      /* 自訂特務綠色按鈕的共通 Style */
      .btn-aegis { background: #18181b; border: 1px solid #27272a; color: #fafafa; transition: 0.2s; }
      .btn-aegis:hover { border-color: #00b37e; color: #00b37e; }
    </style>
  </head>
  <body class={className}>
    <slot /> 
  </body>
</html>