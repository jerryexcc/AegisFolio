---
// src/pages/card.astro
import BaseLayout from '../layouts/BaseLayout.astro';

const realName = import.meta.env.PUBLIC_REAL_NAME || "特務小明";
const lineId = import.meta.env.PUBLIC_LINE_ID || "@aegis_jerry";
const email = import.meta.env.PUBLIC_EMAIL || "";
const phone = import.meta.env.PUBLIC_PHONE_NUMBER || "";
const jobTitle = "資深 Android 開發工程師 & 系統分析師 (SA) | AI 應用整合專家";
const title = `${realName} | 數位名片`;
const description = `${realName} - ${jobTitle} | AegisFolio 數位名片`;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

---

<BaseLayout title={title} description={description} image="/avatar.svg">
  <main class="card-page">
    <div class="card-container animate-fade-in">
      
      <!-- Top Status Pill -->
      <div class="top-status">
        <div class="badge-status">
          <span class="status-dot"></span>
          <span>特務狀態：在線 (公開模式)</span>
        </div>
      </div>

      <!-- Avatar Profile Header -->
      <header class="profile-header">
        <div class="avatar-wrapper">
          <img src={`${base}/avatar_main.png`} alt={realName} class="avatar-img" width="104" height="104" />
          <div class="avatar-badge" title="Aegis 驗證開發者">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="20 6 9 17 4 12"></polyline>
            </svg>
          </div>
        </div>

        <h1 class="profile-name">{realName}</h1>
        <p class="profile-role">{jobTitle}</p>
        <div class="profile-line-id">
          <svg class="line-icon" viewBox="0 0 36 36" width="18" height="18" fill="currentColor" aria-hidden="true">
            <path d="M35.24 15.4C35.24 7.22 27.41 0.6 17.63 0.6S0 7.22 0 15.4c0 7.35 6.53 13.51 15.34 14.67.6.13 1.41.4 1.61.91.18.47.12 1.2.06 1.68l-.26 1.55c-.08.47-.37 1.84 1.61 1 1.98-.84 10.7-6.31 14.6-10.8 2.69-2.96 3.98-5.96 3.98-9.01z"/>
            <path fill="#fff" d="M14.38 11.92h-1.23a.34.34 0 0 0-.34.34v7.65c0 .19.15.34.34.34h1.23c.19 0 .34-.15.34-.34v-7.65a.34.34 0 0 0-.34-.34zm8.55 0h-1.23a.34.34 0 0 0-.34.34v4.54l-3.5-4.73a.39.39 0 0 0-.03-.04l-.02-.02-.02-.01-.02-.01-.02-.01h-.02l-.02-.01h-.02l-.02-.01h-1.25a.34.34 0 0 0-.34.34v7.65c0 .19.15.34.34.34h1.23c.19 0 .34-.15.34-.34v-4.54l3.51 4.74c.06.09.15.14.24.14h1.23c.19 0 .34-.15.34-.34v-7.65a.34.34 0 0 0-.34-.34zm-12.57 6.42H7.72v-6.08a.34.34 0 0 0-.34-.34H6.15a.34.34 0 0 0-.34.34v7.65c0 .09.04.17.1.23.06.06.14.1.23.1h4.22c.19 0 .34-.15.34-.34v-1.22a.34.34 0 0 0-.34-.34zm17.96-5.2c.19 0 .34-.15.34-.34v-1.22a.34.34 0 0 0-.34-.34h-4.22a.33.33 0 0 0-.23.1.33.33 0 0 0-.1.23v7.65c0 .09.04.17.1.23.06.06.14.1.23.1h4.22c.19 0 .34-.15.34-.34v-1.22a.34.34 0 0 0-.34-.34h-2.64v-1.29h2.64c.19 0 .34-.15.34-.34v-1.22a.34.34 0 0 0-.34-.34h-2.64v-1.29h2.64z"/>
          </svg>
          <span class="line-id-label">LINE</span>
          <span class="line-id-value">{lineId}</span>
        </div>

        {phone && (
          <a href={`tel:${phone.replace(/-/g, '')}`} class="profile-phone" aria-label={`撥打電話至 ${phone}`}>
            <svg class="phone-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 12a19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 3.6 1.27h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L7.91 8.9a16 16 0 0 0 6 6l.92-.92a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 21.73 16.92z"/>
            </svg>
            <span class="phone-label">PHONE</span>
            <span class="phone-value">{phone}</span>
          </a>
        )}

        {email && (
          <a href={`mailto:${email}`} class="profile-email" aria-label={`傳送 Email 至 ${email}`}>
            <svg class="email-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect x="2" y="4" width="20" height="16" rx="2"/>
              <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>
            </svg>
            <span class="email-label">EMAIL</span>
            <span class="email-value">{email}</span>
          </a>
        )}
      </header>

      <!-- Quick Actions / Social Footer -->
      <footer class="card-footer">
        <button id="copy-btn" class="action-pill" aria-label="複製名片連結">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
            <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
          </svg>
          <span id="copy-text">分享 / 複製連結</span>
        </button>

        <p class="footer-note">
          🛡️ Aegis Security Protocol • Built with Astro
        </p>
      </footer>

    </div>
  </main>
</BaseLayout>

<script>
  const copyBtn = document.getElementById('copy-btn');
  const copyText = document.getElementById('copy-text');

  if (copyBtn && copyText) {
    copyBtn.addEventListener('click', async () => {
      try {
        if (navigator.share) {
          await navigator.share({
            title: document.title,
            url: window.location.href,
          });
        } else {
          await navigator.clipboard.writeText(window.location.href);
          copyText.textContent = "已複製名片連結！✓";
          setTimeout(() => {
            copyText.textContent = "分享 / 複製連結";
          }, 2500);
        }
      } catch (err) {
        // user canceled share
      }
    });
  }
</script>

<style>
  .card-page {
    min-height: 100vh;
    display: flex;
    justify-content: center;
    align-items: center;
    padding: 40px 16px;
  }

  .card-container {
    width: 100%;
    max-width: 480px;
    background: rgba(18, 18, 20, 0.85);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border: 1px solid var(--border-subtle);
    border-radius: 24px;
    padding: 32px 24px;
    box-shadow: 0 20px 40px -15px rgba(0, 0, 0, 0.7), 0 0 24px -6px var(--accent-glow);
  }

  .top-status {
    display: flex;
    justify-content: center;
    margin-bottom: 24px;
  }

  .profile-header {
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .avatar-wrapper {
    position: relative;
    width: 104px;
    height: 104px;
    margin-bottom: 18px;
  }

  .avatar-img {
    width: 104px;
    height: 104px;
    border-radius: 50%;
    border: 2px solid var(--accent-primary);
    box-shadow: 0 0 24px var(--accent-glow-strong);
    background: #09090b;
    object-fit: cover;
    transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.3s ease;
  }

  .avatar-wrapper:hover .avatar-img {
    transform: scale(1.05);
    box-shadow: 0 0 32px var(--accent-primary);
  }

  .avatar-badge {
    position: absolute;
    bottom: 2px;
    right: 2px;
    width: 26px;
    height: 26px;
    background: var(--accent-primary);
    color: #000000;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 2px solid #121214;
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.4);
  }

  .profile-name {
    font-size: 24px;
    font-weight: 700;
    margin: 0 0 6px 0;
    letter-spacing: -0.01em;
  }

  .profile-role {
    font-size: 13px;
    color: var(--accent-primary);
    font-family: var(--font-mono);
    margin: 0 0 16px 0;
    font-weight: 500;
    line-height: 1.5;
    padding: 0 8px;
  }

  .profile-line-id {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 12px;
    background: rgba(0, 195, 91, 0.08);
    border: 1px solid rgba(0, 195, 91, 0.25);
    border-radius: 9999px;
    padding: 6px 16px 6px 10px;
    transition: all 0.2s ease;
  }

  .profile-line-id:hover {
    background: rgba(0, 195, 91, 0.15);
    border-color: rgba(0, 195, 91, 0.5);
  }

  .profile-phone {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 12px;
    background: rgba(245, 158, 11, 0.08);
    border: 1px solid rgba(245, 158, 11, 0.25);
    border-radius: 9999px;
    padding: 6px 16px 6px 10px;
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .profile-phone:hover {
    background: rgba(245, 158, 11, 0.15);
    border-color: rgba(245, 158, 11, 0.5);
  }

  .phone-icon {
    color: #f59e0b;
    flex-shrink: 0;
  }

  .phone-label {
    font-size: 11px;
    font-family: var(--font-mono);
    font-weight: 700;
    color: #f59e0b;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .phone-value {
    font-size: 13px;
    font-weight: 600;
    color: var(--text-primary);
    font-family: var(--font-mono);
  }

  .profile-email {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 28px;
    background: rgba(99, 102, 241, 0.08);
    border: 1px solid rgba(99, 102, 241, 0.25);
    border-radius: 9999px;
    padding: 6px 16px 6px 10px;
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .profile-email:hover {
    background: rgba(99, 102, 241, 0.15);
    border-color: rgba(99, 102, 241, 0.5);
  }

  .email-icon {
    color: #818cf8;
    flex-shrink: 0;
  }

  .email-label {
    font-size: 11px;
    font-family: var(--font-mono);
    font-weight: 700;
    color: #818cf8;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .email-value {
    font-size: 13px;
    font-weight: 600;
    color: var(--text-primary);
    font-family: var(--font-mono);
  }

  .line-icon {
    color: #06C755;
    flex-shrink: 0;
  }

  .line-id-label {
    font-size: 11px;
    font-family: var(--font-mono);
    font-weight: 700;
    color: #06C755;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .line-id-value {
    font-size: 14px;
    font-weight: 600;
    color: var(--text-primary);
    font-family: var(--font-mono);
  }

  .links-stack {
    display: flex;
    flex-direction: column;
    gap: 12px;
    margin-bottom: 28px;
  }

  .link-item {
    display: flex;
    align-items: center;
    gap: 16px;
    background: var(--bg-card);
    border: 1px solid var(--border-subtle);
    padding: 16px 18px;
    border-radius: 14px;
    transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
    color: var(--text-primary);
    position: relative;
    overflow: hidden;
  }

  .link-item:hover {
    background: var(--bg-card-hover);
    border-color: var(--accent-primary);
    transform: translateY(-2px);
    box-shadow: 0 8px 24px -4px rgba(0, 0, 0, 0.5), 0 0 16px -2px var(--accent-glow);
  }

  .link-highlight {
    border-color: rgba(0, 179, 126, 0.4);
    background: linear-gradient(135deg, rgba(0, 179, 126, 0.08) 0%, rgba(24, 24, 27, 0.9) 100%);
  }

  .link-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    background: #27272a;
    border-radius: 10px;
    color: var(--accent-primary);
    flex-shrink: 0;
    transition: all 0.25s ease;
  }

  .link-item:hover .link-icon {
    background: var(--accent-primary);
    color: #000;
    transform: scale(1.05);
  }

  .link-content {
    flex: 1;
    min-width: 0;
  }

  .link-title-row {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 3px;
  }

  .link-title {
    font-size: 15px;
    font-weight: 600;
    color: var(--text-primary);
  }

  .link-badge {
    font-size: 10px;
    font-family: var(--font-mono);
    padding: 2px 6px;
    border-radius: 4px;
    background: rgba(0, 179, 126, 0.15);
    color: var(--accent-primary);
    font-weight: 600;
    text-transform: uppercase;
  }

  .link-subtitle {
    font-size: 12px;
    color: var(--text-muted);
    margin: 0;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .link-arrow {
    color: var(--text-muted);
    transition: transform 0.2s ease, color 0.2s ease;
    flex-shrink: 0;
  }

  .link-item:hover .link-arrow {
    color: var(--accent-primary);
    transform: translateX(3px);
  }

  .card-footer {
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
  }

  .action-pill {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: transparent;
    border: 1px solid var(--border-subtle);
    color: var(--text-secondary);
    padding: 8px 16px;
    border-radius: 9999px;
    font-size: 13px;
    font-family: var(--font-sans);
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .action-pill:hover {
    border-color: var(--accent-primary);
    color: var(--accent-primary);
    background: rgba(0, 179, 126, 0.05);
  }

  .footer-note {
    font-size: 12px;
    color: var(--text-muted);
    margin: 0;
  }
</style>