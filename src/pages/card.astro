---
import BaseLayout from '../../layouts/BaseLayout.astro'
const realName = import.meta.env.PUBLIC_REAL_NAME || "特務小明";
const links = [
  { label: "🕵️‍♂️ 技術作品與火力展示 (主站)", url: "/" },
  { label: "🎤 GDG 演講與簡報專區", url: "/gdg" },
  { label: "🐙 GitHub 原始碼", url: "https://github.com/jerryexcc" }
]
---
<html lang="zh-TW">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{realName} | 數位名片</title>
    <style>
      body { background: #09090b; color: #fafafa; font-family: sans-serif; display: flex; justify-content: center; align-items: center; min-height: 100vh; margin: 0; }
      .container { width: 100%; max-width: 400px; text-align: center; padding: 20px; }
      .avatar { width: 96px; height: 96px; background: #27272a; border-radius: 50%; margin: 0 auto 20px; border: 2px solid #00b37e; }
      .btn { display: block; background: #18181b; border: 1px solid #27272a; color: #fafafa; padding: 16px; margin: 12px 0; border-radius: 8px; text-decoration: none; transition: 0.2s; }
      .btn:hover { background: #27272a; border-color: #00b37e; }
    </style>
  </head>
  <body>
    <div class="container">
      <div class="avatar"></div>
      <h2>{realName}</h2>
      <p style="color: #a1a1aa; font-size: 14px;">Senior Android / Front-End Developer</p>
      
      <nav style="margin-top: 30px;">
        {links.map(link => (
          <a href={link.url} class="btn">{link.label}</a>
        ))}
      </nav>
    </div>
  </body>
</html>