---
// src/pages/index.astro
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

// 1. 在編譯階段撈取所有專案資料
const allProjects = await getCollection('projects');
const realName = import.meta.env.PUBLIC_REAL_NAME || "特務小明";
const pageTitle = `${realName} | AegisFolio 特務級作品庫`;
const pageDescription = `${realName} 的個人作品集檔案庫。收錄 Android 底層架構、BLE IoT 系統與現代 Web 解決方案。`;
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <div class="home-layout">
    
    <!-- Top Navigation Bar -->
    <header class="top-nav">
      <div class="nav-inner">
        <a href="/" class="brand-logo">
          <img src="/avatar.svg" alt="Aegis" width="32" height="32" class="brand-icon" />
          <span class="brand-text">Aegis<span class="brand-highlight">Folio</span></span>
        </a>

        <nav class="nav-links">
          <a href="/card" class="nav-pill nav-pill-highlight">
            <span class="pill-icon">🪪</span>
            <span>數位名片</span>
          </a>
          <a href="/gdg" class="nav-pill">
            <span class="pill-icon">🎤</span>
            <span>GDG 演講</span>
          </a>
          <a href="https://github.com/jerryexcc" target="_blank" rel="noopener noreferrer" class="nav-icon-link" title="GitHub">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
              <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0 0 24 12c0-6.63-5.37-12-12-12z"/>
            </svg>
          </a>
        </nav>
      </div>
    </header>

    <main class="main-content animate-fade-in">
      
      <!-- Terminal Defense Banner -->
      <section class="security-banner glass-panel">
        <div class="terminal-header">
          <div class="terminal-dots">
            <span class="dot dot-red"></span>
            <span class="dot dot-yellow"></span>
            <span class="dot dot-green"></span>
          </div>
          <span class="terminal-title">AEGIS-CORE // SECURITY PROTOCOL</span>
        </div>
        <div class="terminal-body">
          <p class="terminal-code">
            <span class="prompt">&gt;</span> SYSTEM STATUS: <span class="status-ok">ONLINE [PUBLIC SAFE MODE]</span><br />
            <span class="prompt">&gt;</span> DEFENSE LEVEL: <span class="status-shield">ACTIVE</span> | SENSITIVE IP REDACTION: <span class="status-ok">ENABLED</span><br />
            <span class="prompt">&gt;</span> 歡迎來到 {realName} 的作品檔案庫。商業專案已完成合規脫敏保護。
          </p>
        </div>
      </section>

      <!-- Hero Header -->
      <section class="hero-section">
        <div class="hero-badge">
          <span class="status-dot"></span>
          <span>資深 Android &amp; 前端開發者</span>
        </div>
        <h1 class="hero-title">
          構建高穩定性系統與<br />
          <span class="gradient-text">自帶防禦機制的現代應用</span>
        </h1>
        <p class="hero-desc">
          深耕 Android 底層連線、BLE / IoT 狀態機與現代 Web 全端架構。致力於將複雜的硬體通訊協議轉化為流暢可靠的軟體體驗。
        </p>
        <div class="hero-cta-row">
          <a href="#projects" class="btn-aegis btn-primary">
            <span>瀏覽作品檔案</span>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <line x1="12" y1="5" x2="12" y2="19"></line>
              <polyline points="19 12 12 19 5 12"></polyline>
            </svg>
          </a>
          <a href="/card" class="btn-aegis">
            <span>🪪 查看數位名片</span>
          </a>
        </div>
      </section>

      <!-- Project Archive Section -->
      <section id="projects" class="projects-section">
        <div class="section-title-row">
          <div>
            <h2 class="section-title">💼 核心專案檔案庫</h2>
            <p class="section-subtitle">點擊卡片可深入檢視專案架構、技術解密與成果細節</p>
          </div>
          <span class="counter-badge">{allProjects.length} 個已存檔專案</span>
        </div>

        <div class="projects-grid">
          {allProjects.map((project) => (
            <a href={`/projects/${project.id}`} class="project-card card">
              <div class="card-top-meta">
                {project.data.isPrivate ? (
                  <span class="badge-private">
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                      <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                      <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
                    </svg>
                    商業機密保護中
                  </span>
                ) : (
                  <span class="badge-public">
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                      <polyline points="20 6 9 17 4 12"></polyline>
                    </svg>
                    公開專案
                  </span>
                )}
                <span class="card-period">{project.data.period}</span>
              </div>

              <h3 class="card-title">{project.data.title}</h3>
              <p class="card-summary">{project.data.summary}</p>

              <!-- Tags -->
              <div class="card-tags">
                {project.data.tags.map((tag: string) => (
                  <span class="tag">#{tag}</span>
                ))}
              </div>

              <!-- Card Bottom Link -->
              <div class="card-footer-link">
                <span>深入檢視架構詳情</span>
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                  <line x1="5" y1="12" x2="19" y2="12"></line>
                  <polyline points="12 5 19 12 12 19"></polyline>
                </svg>
              </div>
            </a>
          ))}
        </div>
      </section>

      <!-- GDG Feature Banner -->
      <section class="gdg-feature glass-panel">
        <div class="gdg-content">
          <span class="gdg-tag">⚡ GDG DevFest 2026</span>
          <h3>「深入淺出 Android 藍牙與邊緣運算整合實戰」</h3>
          <p>演講投影片、開源範例專案與現場脫敏 Live Demo 模擬器專區。</p>
        </div>
        <a href="/gdg" class="btn-aegis gdg-btn">
          <span>開啟演講專頁</span>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="9 18 15 12 9 6"></polyline>
          </svg>
        </a>
      </section>

    </main>

    <!-- Site Footer -->
    <footer class="site-footer">
      <div class="footer-inner">
        <p>© 2026 {realName} • AegisFolio Defense System</p>
        <p class="footer-tech">Powered by Astro 7 • Islands Architecture</p>
      </div>
    </footer>

  </div>
</BaseLayout>

<style>
  .home-layout {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
  }

  .top-nav {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgba(9, 9, 11, 0.8);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border-bottom: 1px solid var(--border-subtle);
  }

  .nav-inner {
    max-width: 960px;
    margin: 0 auto;
    padding: 16px 20px;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .brand-logo {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-weight: 700;
    font-size: 18px;
    letter-spacing: -0.02em;
  }

  .brand-icon {
    border-radius: 50%;
    border: 1px solid var(--accent-primary);
  }

  .brand-highlight {
    color: var(--accent-primary);
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .nav-pill {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 13px;
    font-weight: 500;
    padding: 6px 14px;
    border-radius: 8px;
    background: var(--bg-card);
    border: 1px solid var(--border-subtle);
    color: var(--text-secondary);
    transition: all 0.2s ease;
  }

  .nav-pill:hover {
    border-color: var(--accent-primary);
    color: var(--accent-primary);
    transform: translateY(-1px);
  }

  .nav-pill-highlight {
    background: rgba(0, 179, 126, 0.1);
    border-color: rgba(0, 179, 126, 0.35);
    color: #00d696;
  }

  .nav-icon-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 34px;
    height: 34px;
    border-radius: 8px;
    color: var(--text-secondary);
    border: 1px solid var(--border-subtle);
    background: var(--bg-card);
    transition: all 0.2s ease;
  }

  .nav-icon-link:hover {
    color: var(--text-primary);
    border-color: var(--border-hover);
  }

  .main-content {
    max-width: 960px;
    width: 100%;
    margin: 0 auto;
    padding: 30px 20px 60px;
    flex: 1;
  }

  /* Terminal Security Banner */
  .security-banner {
    padding: 0;
    margin-bottom: 40px;
    overflow: hidden;
    background: rgba(18, 18, 20, 0.9);
  }

  .terminal-header {
    background: #141416;
    padding: 10px 16px;
    display: flex;
    align-items: center;
    gap: 12px;
    border-bottom: 1px solid var(--border-subtle);
  }

  .terminal-dots {
    display: flex;
    gap: 6px;
  }

  .dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
  }
  .dot-red { background: #f75a68; }
  .dot-yellow { background: #f59e0b; }
  .dot-green { background: #00b37e; }

  .terminal-title {
    font-size: 11px;
    font-family: var(--font-mono);
    color: var(--text-muted);
    letter-spacing: 0.05em;
  }

  .terminal-body {
    padding: 14px 18px;
  }

  .terminal-code {
    font-family: var(--font-mono);
    font-size: 12px;
    line-height: 1.8;
    color: var(--text-secondary);
    margin: 0;
  }

  .terminal-code .prompt {
    color: var(--accent-primary);
    font-weight: bold;
  }

  .status-ok {
    color: #00d696;
    font-weight: 600;
  }

  .status-shield {
    color: #60a5fa;
    font-weight: 600;
  }

  /* Hero */
  .hero-section {
    margin-bottom: 50px;
  }

  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 6px 14px;
    background: rgba(0, 179, 126, 0.08);
    border: 1px solid rgba(0, 179, 126, 0.25);
    border-radius: 9999px;
    font-size: 13px;
    color: #00d696;
    font-family: var(--font-mono);
    margin-bottom: 20px;
  }

  .hero-title {
    font-size: clamp(28px, 5vw, 44px);
    line-height: 1.2;
    margin-bottom: 20px;
    letter-spacing: -0.03em;
  }

  .gradient-text {
    background: linear-gradient(135deg, #00b37e 0%, #38bdf8 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .hero-desc {
    font-size: 17px;
    color: var(--text-secondary);
    max-width: 680px;
    line-height: 1.7;
    margin-bottom: 28px;
  }

  .hero-cta-row {
    display: flex;
    gap: 14px;
    flex-wrap: wrap;
  }

  /* Projects Section */
  .projects-section {
    margin-bottom: 60px;
  }

  .section-title-row {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: 24px;
    flex-wrap: wrap;
    gap: 12px;
  }

  .section-title {
    font-size: 24px;
    margin: 0 0 6px 0;
  }

  .section-subtitle {
    font-size: 14px;
    color: var(--text-muted);
    margin: 0;
  }

  .counter-badge {
    font-size: 12px;
    font-family: var(--font-mono);
    color: var(--text-muted);
    background: var(--bg-card);
    border: 1px solid var(--border-subtle);
    padding: 4px 10px;
    border-radius: 6px;
  }

  .projects-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(380px, 1fr));
    gap: 20px;
  }

  .project-card {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    cursor: pointer;
  }

  .card-top-meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 14px;
  }

  .card-period {
    font-size: 12px;
    font-family: var(--font-mono);
    color: var(--text-muted);
  }

  .card-title {
    font-size: 19px;
    margin: 0 0 10px 0;
    line-height: 1.4;
    transition: color 0.2s ease;
  }

  .project-card:hover .card-title {
    color: var(--accent-primary);
  }

  .card-summary {
    font-size: 14px;
    color: var(--text-secondary);
    line-height: 1.6;
    margin: 0 0 18px 0;
    flex: 1;
  }

  .card-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-bottom: 20px;
  }

  .card-footer-link {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 13px;
    font-weight: 600;
    color: var(--accent-primary);
    border-top: 1px solid var(--border-subtle);
    padding-top: 14px;
    margin-top: auto;
    transition: gap 0.2s ease;
  }

  .project-card:hover .card-footer-link {
    gap: 10px;
  }

  /* GDG Feature Banner */
  .gdg-feature {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 28px 32px;
    border-left: 4px solid var(--accent-blue);
    gap: 20px;
    flex-wrap: wrap;
  }

  .gdg-content {
    flex: 1;
    min-width: 280px;
  }

  .gdg-tag {
    font-size: 12px;
    font-family: var(--font-mono);
    font-weight: bold;
    color: var(--accent-blue);
    display: block;
    margin-bottom: 6px;
  }

  .gdg-content h3 {
    font-size: 18px;
    margin: 0 0 6px 0;
  }

  .gdg-content p {
    font-size: 14px;
    color: var(--text-secondary);
    margin: 0;
  }

  .gdg-btn {
    border-color: var(--accent-blue);
    color: #ffffff;
    background: rgba(66, 133, 244, 0.15);
  }

  .gdg-btn:hover {
    background: var(--accent-blue);
    color: #ffffff;
    border-color: var(--accent-blue);
    box-shadow: 0 0 20px rgba(66, 133, 244, 0.4);
  }

  /* Footer */
  .site-footer {
    border-top: 1px solid var(--border-subtle);
    background: var(--bg-surface);
    padding: 30px 20px;
    margin-top: auto;
  }

  .footer-inner {
    max-width: 960px;
    margin: 0 auto;
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 12px;
    font-size: 13px;
    color: var(--text-muted);
  }

  .footer-inner p {
    margin: 0;
  }

  .footer-tech {
    font-family: var(--font-mono);
  }

  @media (max-width: 640px) {
    .projects-grid {
      grid-template-columns: 1fr;
    }
    .gdg-feature {
      padding: 20px;
      flex-direction: column;
      align-items: flex-start;
    }
    .gdg-btn {
      width: 100%;
    }
  }
</style>